#include <iostream>
using namespace std;
 
int main()
{
    long long int a, b, c, d;
    cin >> a >> b >> c >> d;
 
    if (c >= a && c <= b)
    {
        if (d <= b)
        {
            cout << c << " " << d;
        }
        else if (d >= b)
        {
            cout << c << " " << b;
        }
    }
    else if (a >= c && a <= d)
    {
        if (d <= b)
        {
            cout << a << " " << d;
        }
        else if (d >= b)
        {
            cout << a << " " << b;
        }
    }
    else
    {
        cout << "-1";
    }
 
    return 0;
}
