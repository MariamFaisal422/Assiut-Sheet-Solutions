        {
            cout << b << "\n"
                 << c << "\n"
                 << a << "\n";
        }
    }
    else if (b >= a && b >= c)
    {
        if (a >= c)
        {
            cout << c << "\n"
                 << a << "\n"
                 << b << "\n";
        }
        else if (c >= a)
        {
            cout << a << "\n"
                 << c << "\n"
                 << b << "\n";
        }
    }
    else if (c >= a && c >= b)
    {
        if (a >= b)
        {
            cout << b << "\n"
                 << a << "\n"
                 << c << "\n";
        }
        else if (b >= a)
        {
            cout << a << "\n"
                 << b << "\n"
                 << c << "\n";
        }
    }
 
