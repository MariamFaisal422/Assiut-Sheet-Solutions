#include <iostream>
#include <string>
using namespace std;
 
int main() {
    string input;
    getline(cin, input);  // Read the entire input line
 
    char operation;
    int A, B;
    
    // Find the position of the operator and parse the numbers accordingly
    if (input.find('+') != string::npos) {
        operation = '+';
    } else if (input.find('-') != string::npos) {
        operation = '-';
    } else if (input.find('*') != string::npos) {
        operation = '*';
    } else if (input.find('/') != string::npos) {
        operation = '/';
    }
 
    size_t pos = input.find(operation);
    A = stoi(input.substr(0, pos));
    B = stoi(input.substr(pos + 1));
    
    int result;
    switch (operation) {
        case '+':
            result = A + B;
            break;
        case '-':
            result = A - B;
            break;
        case '*':
            result = A * B;
            break;
        case '/':
            result = A / B;  // Integer division
            break;
    }
    
    cout << result << endl;
    
    return 0;
}
