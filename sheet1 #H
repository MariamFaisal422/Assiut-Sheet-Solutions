#include <iostream>
#include <cmath>  // For floor, ceil, and round functions
using namespace std;
 
int main() {
    int A, B;
    cin >> A >> B;
    
    int floorResult = floor(static_cast<double>(A) / B);
    int ceilResult = ceil(static_cast<double>(A) / B);
    int roundResult = round(static_cast<double>(A) / B);
    
    cout << "floor " << A << " / " << B << " = " << floorResult << endl;
    cout << "ceil " << A << " / " << B << " = " << ceilResult << endl;
    cout << "round " << A << " / " << B << " = " << roundResult << endl;
 
    return 0;
}
